{
  "name": "hermes-zouroboros",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Hermes Agent with Zouroboros memory, swarm and factory intake for a Linux VPS",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=20",
    "bun": ">=1.3.12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r exec tsc --noEmit && tsc --noEmit",
    "test": "bun test tests",
    "setup": "bun integration/cli.ts init",
    "doctor": "bun integration/cli.ts doctor",
    "mcp": "bun integration/mcp.ts",
    "verify:portable": "bun scripts/ci/verify-portable-runtime.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.0",
    "zouroboros-core": "workspace:*",
    "zouroboros-memory": "workspace:*",
    "zouroboros-swarm": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3"
  }
}
